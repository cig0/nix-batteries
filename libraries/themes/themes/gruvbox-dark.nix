# Theme module. Do not remove this header.
# Gruvbox Dark — warm retro colors with an amber accent
{ }:
{
  boldFactor = 1.0;
  dimFactor = 0.55;

  slots = rec {
    zero = "#fabd2f"; # Bright yellow
    one = "#ebdbb2"; # Light foreground
    two = "#8ec07c"; # Bright aqua
    three = "#b8bb26"; # Bright green
    four = "#d3869b"; # Bright purple
    five = "#fb4934"; # Bright red
    six = "#fe8019"; # Bright orange
    seven = "#83a598"; # Bright blue

    bold_zero = zero;
    bold_one = one;
    bold_two = two;
    bold_three = three;
    bold_four = four;
    bold_five = five;
    bold_six = six;
    bold_seven = seven;

    dimmed_zero = zero;
    dimmed_one = one;
  };
}
