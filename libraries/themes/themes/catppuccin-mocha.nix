# Theme module. Do not remove this header.
# Catppuccin Mocha — soft pastels with a Mauve accent
{ }:
{
  boldFactor = 1.0;
  dimFactor = 0.55;

  slots = rec {
    zero = "#cba6f7"; # Mauve
    one = "#cdd6f4"; # Text
    two = "#94e2d5"; # Teal
    three = "#74c7ec"; # Sapphire
    four = "#fab387"; # Peach
    five = "#f38ba8"; # Red
    six = "#f5c2e7"; # Pink
    seven = "#a6e3a1"; # Green

    bold_zero = zero;
    bold_one = one;
    bold_two = two;
    bold_three = three;
    bold_four = four;
    bold_five = five;
    bold_six = six;
    bold_seven = seven;

    dimmed_zero = zero;
    dimmed_one = one;
  };
}
