    one = "#f8fafc";
    two = "#06b6d4";
    three = "#d946ef";
    four = "#f59e0b";
    five = "#ef4444";
    six = "#ff6600";
    seven = "#22c55e";

    bold_zero = zero;
    bold_one = one;
    bold_two = two;
    bold_three = three;
    bold_four = four;
    bold_five = five;
    bold_six = six;
    bold_seven = seven;

    dimmed_zero = zero;
    dimmed_one = one;
  };
}
