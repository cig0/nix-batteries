# Theme module. Do not remove this header.
# Nushell inspired — terminal colors matching Nushell's default color roles
{ }:
{
  boldFactor = 1.0;
  dimFactor = 0.55;

  roles = {
    accent = "#00cd00"; # Green
    emphasis = "#ffffff"; # White
    option = "#0000ee"; # Blue
    success = "#00cd00"; # Green
    value = "#cdcd00"; # Yellow
    warning = "#cdcd00"; # Yellow
    error = "#cd0000"; # Red
    notice = "#ff87ff"; # Light purple
    context = "#00cdcd"; # Cyan
  };
}
